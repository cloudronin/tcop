diff --git a/pkg/gateway/local_authorization.go b/pkg/gateway/local_authorization.go
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/pkg/gateway/local_authorization.go
@@ -0,0 +1,81 @@
+package gateway
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+// LocalAuthorizationRequest is intentionally gateway-generic. Its fields are
+// local call facts, not remote instructions or protocol evidence.
+type LocalAuthorizationRequest struct {
+	SessionID  string `json:"session_id"`
+	ClientName string `json:"client_name"`
+	Server     string `json:"server"`
+	Tool       string `json:"tool"`
+}
+
+// LocalAuthorizationDecision is a decision made by the receiving deployment.
+type LocalAuthorizationDecision struct {
+	Allowed         bool   `json:"allowed"`
+	DecisionID      string `json:"decision_id"`
+	PolicyID        string `json:"policy_id"`
+	AuthorityDomain string `json:"authority_domain"`
+}
+
+type LocalAuthorizationEvaluator interface {
+	Evaluate(context.Context, LocalAuthorizationRequest) (LocalAuthorizationDecision, error)
+}
+
+type httpLocalAuthorizationEvaluator struct {
+	url    string
+	client *http.Client
+}
+
+func newLocalAuthorizationEvaluator(url string) LocalAuthorizationEvaluator {
+	if url == "" {
+		return nil
+	}
+	return &httpLocalAuthorizationEvaluator{url: strings.TrimRight(url, "/"), client: &http.Client{Timeout: 2 * time.Second}}
+}
+
+func (e *httpLocalAuthorizationEvaluator) Evaluate(ctx context.Context, request LocalAuthorizationRequest) (LocalAuthorizationDecision, error) {
+	body, err := json.Marshal(request)
+	if err != nil {
+		return LocalAuthorizationDecision{}, fmt.Errorf("encode local authorization request: %w", err)
+	}
+	httpRequest, err := http.NewRequestWithContext(ctx, http.MethodPost, e.url+"/v1/authorize", bytes.NewReader(body))
+	if err != nil {
+		return LocalAuthorizationDecision{}, fmt.Errorf("create local authorization request: %w", err)
+	}
+	httpRequest.Header.Set("Content-Type", "application/json")
+	response, err := e.client.Do(httpRequest)
+	if err != nil {
+		return LocalAuthorizationDecision{}, fmt.Errorf("call local authorization evaluator: %w", err)
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		return LocalAuthorizationDecision{}, fmt.Errorf("local authorization evaluator returned HTTP %d", response.StatusCode)
+	}
+	var decision LocalAuthorizationDecision
+	if err := json.NewDecoder(response.Body).Decode(&decision); err != nil {
+		return LocalAuthorizationDecision{}, fmt.Errorf("decode local authorization decision: %w", err)
+	}
+	if decision.DecisionID == "" || decision.PolicyID == "" || decision.AuthorityDomain == "" {
+		return LocalAuthorizationDecision{}, fmt.Errorf("local authorization decision omitted required provenance")
+	}
+	return decision, nil
+}
+
+func localClientName(session *mcp.ServerSession) string {
+	if session == nil || session.InitializeParams() == nil {
+		return ""
+	}
+	return session.InitializeParams().ClientInfo.Name
+}
