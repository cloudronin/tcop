{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcop.dev/schemas/agent-trace-v0.1.schema.json",
  "title": "TCOP agent-validation canonical tool trace",
  "type": "object",
  "required": ["trace_id", "scenario", "canonical_action_digest", "calls"],
  "properties": {
    "trace_id": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "pattern": "^RA-[0-9]{2}$"},
    "canonical_action_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ordinal", "method", "tool", "capability"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 1},
          "method": {"const": "tools/call"},
          "tool": {"type": "string", "minLength": 1},
          "capability": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
