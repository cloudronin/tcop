{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcop.example/schemas/tcx-observation-v0.2.schema.json",
  "title": "TCX observation v0.2 witness profile",
  "type": "object",
  "required": ["protocol_version", "message_type", "observation_id", "observer", "subject", "observation_type", "scope", "tenant", "sequence_number", "observed_at", "issued_at", "expires_at", "confidence", "severity", "evidence", "metadata", "declared_evidence_class", "observation_mode", "observer_admin_domain_id", "observer_control_group_id", "subject_admin_domain_id", "subject_control_group_id", "interaction_id", "interaction_receipt_hash", "receipt_mode", "original_observation_id", "relay_chain", "challenge_profile_id", "challenge_profile_version", "patrol_authorization_ref", "privacy_profile", "synthetic_data_only", "signature"],
  "properties": {
    "protocol_version": {"const": "0.2"}, "message_type": {"const": "observation"},
    "observation_id": {"type": "string"}, "observer": {"type": "object"}, "subject": {"type": "object"},
    "observation_type": {"type": "string"}, "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tenant": {"type": "string"}, "sequence_number": {"type": "integer", "minimum": 0},
    "observed_at": {"type": "string"}, "issued_at": {"type": "string"}, "expires_at": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "severity": {"enum": ["informational", "low", "medium", "high", "critical"]},
    "evidence": {"type": "array"}, "metadata": {"type": "object"},
    "declared_evidence_class": {"enum": ["self_assertion", "first_party", "independent_peer", "neutral_third_party", "infrastructure_attestation", "relayed"]},
    "observation_mode": {"enum": ["passive", "active_patrol", "attestation", "relay"]},
    "observer_admin_domain_id": {"type": "string"}, "observer_control_group_id": {"type": "string"},
    "subject_admin_domain_id": {"type": "string"}, "subject_control_group_id": {"type": "string"},
    "interaction_id": {"type": ["string", "null"]}, "interaction_receipt_hash": {"type": ["string", "null"]},
    "receipt_mode": {"enum": ["bilateral", "unilateral_transport", "third_party_witnessed", "none"]},
    "original_observation_id": {"type": ["string", "null"]}, "relay_chain": {"type": "array", "items": {"type": "string"}},
    "challenge_profile_id": {"type": ["string", "null"]}, "challenge_profile_version": {"type": ["string", "null"]},
    "patrol_authorization_ref": {"type": ["string", "null"]}, "privacy_profile": {"type": "string"},
    "synthetic_data_only": {"type": ["boolean", "null"]}, "signature": {"type": "object"}
  },
  "additionalProperties": false
}
